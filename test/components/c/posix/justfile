wit_bindgen := env_var_or_default("WIT_BINDGEN", "wit-bindgen")
wasi_sdk_path := env_var_or_default("WASI_SDK_PATH", env_var_or_default("WASI_SDK", "/opt/wasi-sdk"))
coop_threads_sysroot := wasi_sdk_path / "share/wasi-sysroot/experimental-coop-threads"
posix_dir := justfile_directory()

@_default:
    just --list

build test_case:
    @if [ ! -x "{{wasi_sdk_path}}/bin/clang" ]; then \
        echo '[error] failed to find wasi-sdk clang at {{wasi_sdk_path}}/bin/clang'; \
        echo '    install wasi-sdk 34+ and set WASI_SDK_PATH'; \
        exit 1; \
    fi
    @if [ ! -d "{{coop_threads_sysroot}}" ]; then \
        echo '[error] failed to find experimental coop-threads sysroot at {{coop_threads_sysroot}}'; \
        echo '    install a wasi-sdk 34+ distribution that ships it'; \
        exit 1; \
    fi
    {{wit_bindgen}} c --world biz "{{posix_dir}}/wit" --out-dir "{{posix_dir}}/{{test_case}}/gen"
    {{wasi_sdk_path}}/bin/clang \
        -target wasm32-wasip3 \
        -mexec-model=reactor \
        --sysroot "{{coop_threads_sysroot}}" \
        -pthread \
        -O1 \
        -I "{{posix_dir}}/{{test_case}}/gen" \
        "{{posix_dir}}/{{test_case}}/src/main.c" \
        "{{posix_dir}}/{{test_case}}/gen/biz.c" \
        "{{posix_dir}}/{{test_case}}/gen/biz_component_type.o" \
        -o "{{posix_dir}}/{{test_case}}/component.wasm"