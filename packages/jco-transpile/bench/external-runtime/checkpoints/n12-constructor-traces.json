    "source": "// Diagnostic only. Never execute during timing collection.\nimport assert from 'node:assert/strict';\nimport { readFile, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { createHash } from 'node:crypto';\nconst config = JSON.parse(await readFile(process.argv[2], 'utf8'));\nconst { importsFor, workload } = await import(config.workloads);\nconst artifact = config.artifact;\nconst modules = new Map();\nfor (const name of Object.keys(artifact.wasm.files)) modules.set(name, new WebAssembly.Module(await readFile(join(artifact.dir, name))));\nconst imports = artifact.parts.map(importsFor);\nconst counts = {};\nconst NativeProxy = globalThis.Proxy;\nfor (const key of ['Map', 'Proxy', 'Symbol', 'DataView', 'ArrayBuffer', 'Uint8Array', 'Uint16Array', 'Int32Array', 'Float32Array', 'BigInt64Array', 'Float64Array', 'TextEncoder', 'TextDecoder']) {\n    const original = globalThis[key]; counts[key] = 0;\n    globalThis[key] = new NativeProxy(original, {\n        apply(target, receiver, args) { counts[key]++; return Reflect.apply(target, receiver, args); },\n        construct(target, args, receiver) { counts[key]++; return Reflect.construct(target, args, receiver); },\n    });\n}\nconst binding = await import(pathToFileURL(artifact.bundle).href);\nconst afterImport = { ...counts };\nconst instances = artifact.parts.map((id, i) => binding['create' + i](name => {\n    assert(modules.has(name), 'unexpected core module request ' + name);\n    return modules.get(name);\n}, imports[i]));\nconst afterInstantiate = { ...counts };\nfor (const [i, instance] of instances.entries()) await workload(artifact.parts[i], instance);\nconst afterKnownAnswers = { ...counts };\nconst environment = { node: process.version, flags: process.execArgv, debug: process.env.JCO_DEBUG ?? null };\nconst source = await readFile(new URL(import.meta.url), 'utf8');\nawait writeFile(config.output, JSON.stringify({\n    schema: 1, checkpoint: config.checkpoint, id: config.id, mode: config.mode,\n    beforeTrace: 'core modules compiled, WASI imports constructed and workload helpers loaded',\n    exclusions: 'ordinary objects/array literals, function/class identities, Promise internals and native/Wasm allocations are not counted',\n    environment, afterImport, afterInstantiate, afterKnownAnswers,\n    declaredInitializers: artifact.graph.initializers,\n    declaredContexts: artifact.graph.contexts,\n    sourceSha256: createHash('sha256').update(source).digest('hex'), source,\n}, null, 2) + '\\n');\n",
