;; Forwarding must preserve the lazy host source when the consumed readable
;; end is replaced by a newly created stream/future's readable end.
(component
  (type $S (stream u32))
  (type $F (future u32))
  (canon stream.new $S (core func $stream.new))
  (canon stream.forward $S (core func $stream.forward))
  (canon future.new $F (core func $future.new))
  (canon future.forward $F (core func $future.forward))
  (core module $M
    (import "" "stream.new" (func $stream.new (result i64)))
    (import "" "stream.forward" (func $stream.forward (param i32 i32)))
    (import "" "future.new" (func $future.new (result i64)))
    (import "" "future.forward" (func $future.forward (param i32 i32)))
    (func (export "stream") (param $source i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $stream.new))
      (call $stream.forward (local.get $source)
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (i32.wrap_i64 (local.get $ends)))
    (func (export "invalid-source") (param $source i32)
      (local $ends i64)
      (local.set $ends (call $stream.new))
      (call $stream.forward (local.get $source)
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32)))))
    (func (export "future") (param $source i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $future.new))
      (call $future.forward (local.get $source)
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (i32.wrap_i64 (local.get $ends))))
  (core instance $m (instantiate $M (with "" (instance
    (export "stream.new" (func $stream.new))
    (export "stream.forward" (func $stream.forward))
    (export "future.new" (func $future.new))
    (export "future.forward" (func $future.forward))))))
  (func (export "forward-stream") (param "source" $S) (result $S)
    (canon lift (core func $m "stream")))
  (func (export "invalid-source") (param "source" u32)
    (canon lift (core func $m "invalid-source")))
  (func (export "forward-future") (param "source" $F) (result $F)
    (canon lift (core func $m "future"))))
