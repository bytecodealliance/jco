package test:resource-statics;

interface things {
  resource thing {
    constructor();
    prototype: static func() -> u32;
    name: static func() -> u32;
    length: static func() -> u32;
    arguments: static func() -> u32;
    caller: static func() -> u32;
  }

  resource other {
    constructor();
    prototype: func() -> u32;
  }
}

world exports {
  export things;
}

world imports {
  import things;
  export run: func() -> u32;
}
