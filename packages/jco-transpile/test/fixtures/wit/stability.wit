package test:stability@0.2.0;

interface items {
  /// A stable record.
  @since(version = 0.1.0)
  record stable-record {
    value: u32,
  }

  @since(version = 0.1.0)
  @deprecated(version = 0.2.0)
  enum old-enum {
    first,
  }

  /// Reads the record.
  @since(version = 0.1.0)
  read: func() -> stable-record;

  @since(version = 0.1.0)
  @deprecated(version = 0.2.0)
  old: func() -> old-enum;

  @unstable(feature = experimental-items)
  experimental: func();

  plain: func();

  /// A stable resource.
  @since(version = 0.1.0)
  @deprecated(version = 0.2.0)
  resource handle {
    constructor();
  }
}

interface users {
  @since(version = 0.2.0)
  use items.{old-enum};

  current: func() -> old-enum;
}

world stability {
  @since(version = 0.1.0)
  @deprecated(version = 0.2.0)
  record legacy {
    value: u32,
  }

  import items;
  import users;
}
