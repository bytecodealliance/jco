(component
  (import "bytes" (func $bytes (result (list u8))))
  (import "words" (func $words (result (list u16))))
  (core module $m
    (memory (export "mem") 1 2)
    (global $next (mut i32) (i32.const 0))
    (global $grow (mut i32) (i32.const 0))
    (func (export "set") (param i32 i32)
      (global.set $next (local.get 0)) (global.set $grow (local.get 1)))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (if (global.get $grow) (then (drop (memory.grow (i32.const 1)))))
      (global.get $next)))
  (core instance $m (instantiate $m))
  (alias core export $m "mem" (core memory $mem))
  (alias core export $m "realloc" (core func $realloc))
  (core func $bytes (canon lower (func $bytes) (memory $mem) (realloc $realloc)))
  (core func $words (canon lower (func $words) (memory $mem) (realloc $realloc)))
  (core module $guest
    (import "" "bytes" (func $bytes (param i32)))
    (import "" "words" (func $words (param i32)))
    (import "" "mem" (memory 1 2))
    (func (export "check") (param i32) (result i32)
      (if (local.get 0) (then (call $words (i32.const 4))) (else (call $bytes (i32.const 4))))
      (if (result i32) (i32.load (i32.const 8))
        (then (i32.load8_u (i32.load (i32.const 4)))) (else (i32.const 0)))))
  (core instance $g (instantiate $guest (with "" (instance (export "mem" (memory $mem)) (export "bytes" (func $bytes)) (export "words" (func $words))))))
  (func (export "set") (param "ptr" u32) (param "grow" u32) (canon lift (core func $m "set")))
  (func (export "check") (param "words" u32) (result u32) (canon lift (core func $g "check"))))
