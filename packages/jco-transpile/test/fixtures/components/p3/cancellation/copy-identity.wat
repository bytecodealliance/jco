(component
  (type $S (stream u8))
  (core module $Memory (memory (export "mem") 1))
  (core instance $memory (instantiate $Memory))
  (canon stream.read $S async (memory (core memory $memory "mem")) (core func $read))
  (canon stream.cancel-read $S async (core func $cancel))
  (canon waitable-set.new (core func $new-set))
  (canon waitable.join (core func $join))
  (canon waitable-set.poll (memory (core memory $memory "mem")) (core func $poll))
  (core module $M
    (import "" "mem" (memory 1))
    (import "" "read" (func $read (param i32 i32 i32) (result i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "new-set" (func $new-set (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32)))
    (global $reader (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $last-payload (mut i32) (i32.const 0))
    (func (export "start") (param $source i32) (result i32)
      (global.set $reader (local.get $source))
      (global.set $set (call $new-set))
      (call $join (global.get $reader) (global.get $set))
      (i32.and
        (call $read (global.get $reader) (i32.const 16) (i32.const 1))
        (call $cancel (global.get $reader))))
    (func (export "poll-and-read") (result i32)
      (local $event i32)
      (local.set $event (call $poll (global.get $set) (i32.const 0)))
      (if (local.get $event)
        (then
          (global.set $last-payload (i32.load (i32.const 4)))
          (drop (call $read (global.get $reader) (i32.const 16) (i32.const 1)))))
      (local.get $event))
    (func (export "poll") (result i32)
      (local $event i32)
      (local.set $event (call $poll (global.get $set) (i32.const 0)))
      (if (local.get $event)
        (then (global.set $last-payload (i32.load (i32.const 4)))))
      (local.get $event))
    (func (export "cancel") (result i32) (call $cancel (global.get $reader)))
    (func (export "byte") (result i32) (i32.load8_u (i32.const 16)))
    (func (export "last-payload") (result i32) (global.get $last-payload)))
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "read" (func $read)) (export "cancel" (func $cancel))
    (export "new-set" (func $new-set)) (export "join" (func $join)) (export "poll" (func $poll))))))
  (func (export "start") (param "source" $S) (result u32) (canon lift (core func $m "start")))
  (func (export "poll-and-read") (result u32) (canon lift (core func $m "poll-and-read")))
  (func (export "poll") (result u32) (canon lift (core func $m "poll")))
  (func (export "cancel") (result u32) (canon lift (core func $m "cancel")))
  (func (export "byte") (result u32) (canon lift (core func $m "byte")))
  (func (export "last-payload") (result u32) (canon lift (core func $m "last-payload"))))
