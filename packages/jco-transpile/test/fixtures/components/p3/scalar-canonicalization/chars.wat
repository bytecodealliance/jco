  (canon future.write $F async (memory (core memory $memory "mem")) (core func $write))
  (canon future.read $F (memory (core memory $memory "mem")) (core func $read))
  (core module $M
    (import "" "mem" (memory 1))
    (import "" "new" (func $new (result i64)))
    (import "" "write" (func $write (param i32 i32) (result i32)))
    (import "" "read" (func $read (param i32 i32) (result i32)))
    (func (export "id") (param i32) (result i32) local.get 0)
    (func (export "send") (param $bits i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $new))
      (i32.store (i32.const 0) (local.get $bits))
      (drop (call $write
