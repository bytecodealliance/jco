      (i32.wrap_i64 (local.get $ends)))
    (func (export "receive") (param $source i32) (result i32)
      (drop (call $read (local.get $source) (i32.const 0)))
      (i32.load (i32.const 0))))
  (core instance $m (instantiate $M (with "" (instance
