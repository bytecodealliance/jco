;; Multiple tasks can park in callback event loops in the same component.
(component
  (import "pause" (func $pause async (param "token" s32)))
  (core module $memory (memory (export "mem") 1))
  (core instance $memory (instantiate $memory))
  (core func $pause (canon lower (func $pause) async))
  (core func $get0 (canon context.get i32 0))
  (core func $get1 (canon context.get i32 1))
  (core func $set0 (canon context.set i32 0))
  (core func $set1 (canon context.set i32 1))
  (canon task.return (result s32) (core func $return))
  (canon waitable-set.new (core func $new))
  (canon waitable-set.drop (core func $drop-set))
  (canon waitable.join (core func $join))
  (canon subtask.drop (core func $drop-task))
  (core module $m
    (import "" "mem" (memory 1))
    (import "" "pause" (func $pause (param i32) (result i32)))
    (import "" "get0" (func $get0 (result i32)))
    (import "" "get1" (func $get1 (result i32)))
    (import "" "set0" (func $set0 (param i32)))
    (import "" "set1" (func $set1 (param i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (func (export "run") (param $token i32) (result i32)
      (local $packed i32) (local $subtask i32) (local $set i32)
      (if (call $get0) (then unreachable))
      (if (call $get1) (then unreachable))
      (call $set0 (local.get $token))
      (call $set1 (i32.xor (local.get $token) (i32.const -1)))
      (local.set $packed (call $pause (local.get $token)))
      (if (i32.ne (i32.and (local.get $packed) (i32.const 15)) (i32.const 1)) (then unreachable))
      (local.set $subtask (i32.shr_u (local.get $packed) (i32.const 4)))
      (local.set $set (call $new))
      (i32.store (i32.mul (local.get $subtask) (i32.const 4)) (local.get $set))
      (call $join (local.get $subtask) (local.get $set))
      (i32.or (i32.const 2) (i32.shl (local.get $set) (i32.const 4))))
    (func (export "callback") (param $event i32) (param $subtask i32) (param $status i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
      (if (i32.ne (call $get1) (i32.xor (call $get0) (i32.const -1))) (then unreachable))
      (call $join (local.get $subtask) (i32.const 0))
      (call $drop-set (i32.load (i32.mul (local.get $subtask) (i32.const 4))))
      (call $drop-task (local.get $subtask))
      (call $return (call $get0))
      (i32.const 0)))
  (core instance $m (instantiate $m (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "pause" (func $pause))
    (export "get0" (func $get0)) (export "get1" (func $get1))
    (export "set0" (func $set0)) (export "set1" (func $set1))
    (export "return" (func $return)) (export "new" (func $new))
    (export "join" (func $join)) (export "drop-set" (func $drop-set))
    (export "drop-task" (func $drop-task))))))
  (func (export "run") async (param "token" s32) (result s32)
    (canon lift (core func $m "run") async (callback (core func $m "callback")))))
