;; Distinct tasks retain signed values in both slots across host suspensions.
(component
  (import "pause" (func $pause (param "token" s32)))
  (core func $pause (canon lower (func $pause)))
  (core func $get0 (canon context.get i32 0))
  (core func $get1 (canon context.get i32 1))
  (core func $set0 (canon context.set i32 0))
  (core func $set1 (canon context.set i32 1))
  (core func $return (canon task.return (result s32)))
  (core module $m
    (import "" "pause" (func $pause (param i32)))
    (import "" "get0" (func $get0 (result i32)))
    (import "" "get1" (func $get1 (result i32)))
    (import "" "set0" (func $set0 (param i32)))
    (import "" "set1" (func $set1 (param i32)))
    (import "" "return" (func $return (param i32)))
    (func $check (param $token i32)
      (if (i32.ne (call $get0) (local.get $token)) (then unreachable))
      (if (i32.ne (call $get1) (i32.xor (local.get $token) (i32.const -1))) (then unreachable)))
    (func (export "run") (param $token i32)
      (if (call $get0) (then unreachable))
      (if (call $get1) (then unreachable))
      (call $set0 (local.get $token))
      (call $set1 (i32.xor (local.get $token) (i32.const -1)))
      (call $pause (local.get $token))
      (call $check (local.get $token))
      (call $pause (local.get $token))
      (call $check (local.get $token))
      (call $return (local.get $token)))
    (func (export "trap")
      (call $set0 (i32.const 123))
      (call $set1 (i32.const 456))
      unreachable))
  (core instance $m (instantiate $m (with "" (instance
    (export "pause" (func $pause))
    (export "get0" (func $get0)) (export "get1" (func $get1))
    (export "set0" (func $set0)) (export "set1" (func $set1))
    (export "return" (func $return))))))
  (func (export "run") async (param "token" s32) (result s32)
    (canon lift (core func $m "run") async))
  (func (export "trap") (canon lift (core func $m "trap"))))
