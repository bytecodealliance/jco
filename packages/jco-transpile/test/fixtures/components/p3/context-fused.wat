;; Exercise FACT's context save/clear/restore in both directions, including
;; post-return after the callee task has exited. The guests observe the public context slot.
(component
  (import "pause" (func $pause))
  (component $callee
    (import "pause" (func $pause))
    (core func $pause (canon lower (func $pause)))
    (core func $get0 (canon context.get i32 0))
    (core func $set0 (canon context.set i32 0))
    (core module $m
      (import "" "pause" (func $pause))
      (import "context" "get0" (func $get0 (result i32)))
      (import "context" "set0" (func $set0 (param i32)))
      (memory (export "memory") 1)
      (global $post-count (mut i32) (i32.const 0))
      (func $check (param $a i32)
        (if (i32.ne (call $get0) (local.get $a)) (then unreachable)))
      (func $start
        (call $check (i32.const 0))
        (call $set0 (i32.const 5)))
      (start $start)
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (call $check (i32.const 0))
        (call $set0 (i32.const 90))
        (i32.const 64))
      (func (export "echo") (param $ptr i32) (param $len i32) (result i32)
        (call $check (i32.const 0))
        (call $set0 (i32.const 33))
        (call $pause)
        (call $check (i32.const 33))
        (i32.store (i32.const 8) (local.get $ptr))
        (i32.store (i32.const 12) (local.get $len))
        (i32.const 8))
      (func (export "post") (param i32)
        (call $check (i32.const 33))
        (call $set0 (i32.const 99))
        (global.set $post-count (i32.add (global.get $post-count) (i32.const 1))))
      (func (export "post-count") (result i32) (global.get $post-count)))
    (core instance $context
      (export "get0" (func $get0))
      (export "set0" (func $set0)))
    (core instance $i (instantiate $m
      (with "context" (instance $context))
      (with "" (instance (export "pause" (func $pause))))))
    (func (export "echo") (param "value" string) (result string)
      (canon lift (core func $i "echo") (memory $i "memory")
        (realloc (func $i "realloc")) (post-return (func $i "post"))))
    (func (export "post-count") (result u32)
      (canon lift (core func $i "post-count"))))
  (instance $callee (instantiate $callee (with "pause" (func $pause))))

  (component $caller
    (import "echo" (func $echo (param "value" string) (result string)))
    (core func $get0 (canon context.get i32 0))
    (core func $set0 (canon context.set i32 0))
    (core module $memory
      (import "context" "get0" (func $get0 (result i32)))
      (import "context" "set0" (func $set0 (param i32)))
      (memory (export "memory") 1)
      (data (i32.const 64) "hey")
      (func $check (param $a i32)
        (if (i32.ne (call $get0) (local.get $a)) (then unreachable)))
      (func $start
        (call $check (i32.const 0))
        (call $set0 (i32.const 5)))
      (start $start)
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (call $check (i32.const 0))
        (call $set0 (i32.const 97))
        (i32.const 128)))
    (core instance $context
      (export "get0" (func $get0))
      (export "set0" (func $set0)))
    (core instance $memory (instantiate $memory (with "context" (instance $context))))
    (core func $echo (canon lower (func $echo) (memory $memory "memory")
      (realloc (func $memory "realloc"))))
    (core module $m
      (import "context" "get0" (func $get0 (result i32)))
      (import "context" "set0" (func $set0 (param i32)))
      (import "" "echo" (func $echo (param i32 i32 i32)))
      (import "" "memory" (memory 1))
      (func $check (param $a i32)
        (if (i32.ne (call $get0) (local.get $a)) (then unreachable)))
      (func $start
        (call $check (i32.const 5))
        (call $set0 (i32.const 0)))
      (start $start)
      (func (export "run") (result i32)
        (call $check (i32.const 0))
        (call $set0 (i32.const 11))
        (call $echo (i32.const 64) (i32.const 3) (i32.const 8))
        (call $check (i32.const 11))
        (if (i32.ne (i32.load (i32.const 12)) (i32.const 3)) (then unreachable))
        (if (i32.ne (i32.load8_u (i32.load (i32.const 8))) (i32.const 104)) (then unreachable))
        (i32.const 42)))
    (core instance $i (instantiate $m
      (with "context" (instance $context))
      (with "" (instance (export "echo" (func $echo))
                         (export "memory" (memory $memory "memory"))))))
    (func (export "run") (result u32) (canon lift (core func $i "run"))))
  (instance $caller (instantiate $caller (with "echo" (func $callee "echo"))))
  (export "run" (func $caller "run"))
  (export "post-count" (func $callee "post-count")))
