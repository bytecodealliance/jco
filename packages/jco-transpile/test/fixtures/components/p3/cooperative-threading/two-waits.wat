;; Two threads of the same task can block on a shared waitable set.
(component
  (core module $T (table (export "table") 2 funcref) (memory (export "mem") 1))
  (core instance $t (instantiate $T))
  (alias core export $t "table" (core table $table))
  (core type $ft (func (param i32)))
  (canon thread.new-indirect $ft (core table $table) (core func $new))
  (canon thread.resume-later (core func $resume))
  (canon thread.yield (core func $yield))
  (canon thread.suspend (core func $suspend))
  (canon thread.index (core func $index))
  (canon task.return (result u32) (core func $return))

  (type $F (future))
  (canon waitable-set.new (core func $set-new))
  (canon waitable-set.wait (memory (core memory $t "mem")) (core func $wait))
  (canon waitable.join (core func $join))
  (canon future.new $F (core func $future-new))
  (canon future.read $F async (core func $read))
  (canon future.write $F async (core func $write))

  (core module $M
    (import "" "table" (table 2 funcref))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "resume" (func $resume (param i32)))
    (import "" "yield" (func $yield (result i32)))
    (import "" "suspend" (func $suspend (result i32)))
    (import "" "index" (func $index (result i32)))
    (import "" "return" (func $return (param i32)))

    (import "" "mem" (memory 1))
    (import "" "set-new" (func $set-new (result i32)))
    (import "" "wait" (func $wait (param i32 i32) (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "future-new" (func $future-new (result i64)))
    (import "" "read" (func $read (param i32 i32) (result i32)))
    (import "" "write" (func $write (param i32 i32) (result i32)))

    (global $ws (mut i32) (i32.const 0))
    (func $worker (param i32)
      (drop (call $wait (global.get $ws) (i32.const 32))))
    (func $signal
      (local $f i64) (local $r i32) (local $w i32)
      (local.set $f (call $future-new))
      (local.set $r (i32.wrap_i64 (local.get $f)))
      (local.set $w (i32.wrap_i64 (i64.shr_u (local.get $f) (i64.const 32))))
      (drop (call $read (local.get $r) (i32.const 0)))
      (call $join (local.get $r) (global.get $ws))
      (drop (call $write (local.get $w) (i32.const 0))))
    (func $unblocker (param i32) (call $signal) (call $signal))
    (elem (i32.const 1) func $unblocker)

    (elem (i32.const 0) func $worker)
    (func (export "run")

      (global.set $ws (call $set-new))
      (call $resume (call $new (i32.const 0) (i32.const 0)))
      (call $resume (call $new (i32.const 1) (i32.const 0)))
      (drop (call $wait (global.get $ws) (i32.const 16)))
      (call $return (i32.const 42))
    )
    (func (export "check") (result i32) (i32.const 42))
  )
  (core instance $m (instantiate $M (with "" (instance
          (export "table" (table $table))
          (export "new" (func $new))
          (export "resume" (func $resume))
          (export "yield" (func $yield))
          (export "suspend" (func $suspend))
          (export "index" (func $index))
          (export "return" (func $return))

          (export "mem" (memory $t "mem"))
          (export "set-new" (func $set-new))
          (export "wait" (func $wait))
          (export "join" (func $join))
          (export "future-new" (func $future-new))
          (export "read" (func $read))
          (export "write" (func $write))
  ))))
  (func (export "run") async (result u32) (canon lift (core func $m "run") async))
  (func (export "check") (result u32) (canon lift (core func $m "check")))
)
