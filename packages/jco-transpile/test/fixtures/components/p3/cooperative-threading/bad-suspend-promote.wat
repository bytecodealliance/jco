;; suspend-then-promote must trap on an invalid thread handle.
(component
  (core module $T (table (export "table") 2 funcref))
  (core instance $t (instantiate $T))
  (alias core export $t "table" (core table $table))
  (core type $ft (func (param i32)))
  (canon thread.new-indirect $ft (core table $table) (core func $new))
  (canon thread.resume-later (core func $resume))
  (canon thread.yield (core func $yield))
  (canon thread.suspend (core func $suspend))
  (canon thread.index (core func $index))
  (canon task.return (result u32) (core func $return))
  (canon thread.suspend-then-promote (core func $promote))
  (core module $M
    (import "" "table" (table 2 funcref))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "resume" (func $resume (param i32)))
    (import "" "yield" (func $yield (result i32)))
    (import "" "suspend" (func $suspend (result i32)))
    (import "" "index" (func $index (result i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "promote" (func $promote (param i32) (result i32)))
    (func $worker (param i32))
    (elem (i32.const 0) func $worker)
    (func (export "run")
      (drop (call $promote (i32.const 999))) (call $return (i32.const 42)))
    (func (export "check") (result i32) (i32.const 42))
  )
  (core instance $m (instantiate $M (with "" (instance
          (export "table" (table $table))
          (export "new" (func $new))
          (export "resume" (func $resume))
          (export "yield" (func $yield))
          (export "suspend" (func $suspend))
          (export "index" (func $index))
          (export "return" (func $return))
          (export "promote" (func $promote))))))
  (func (export "run") async (result u32) (canon lift (core func $m "run") async))
  (func (export "check") (result u32) (canon lift (core func $m "check")))
)
