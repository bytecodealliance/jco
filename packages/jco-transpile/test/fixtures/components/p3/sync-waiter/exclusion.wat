      (local.set $end (i32.wrap_i64 (i64.shr_u (local.get $ends)
        (i64.extend_i32_u (i32.mul (i32.and (local.get $kind) (i32.const 1)) (i32.const 32))))))
      (drop (call $yield (call $new-thread (local.get $kind) (local.get $end))))
      (if (i32.eqz (local.get $action))
        (then (call $join (local.get $end) (i32.const 0)))
        (else
          (if (i32.eq (local.get $kind) (i32.const 0)) (then (drop (call $f.cancel-read (local.get $end)))))
          (if (i32.eq (local.get $kind) (i32.const 1)) (then (drop (call $f.cancel-write (local.get $end)))))
          (if (i32.eq (local.get $kind) (i32.const 2)) (then (drop (call $s.cancel-read (local.get $end)))))
          (if (i32.eq (local.get $kind) (i32.const 3)) (then (drop (call $s.cancel-write (local.get $end)))))))
      unreachable))
  (core instance $m (instantiate $M (with "" (instance
