    (func $fw (param i32) (drop (call $f.write (local.get 0) (i32.const 0))))
    (func $sr (param i32) (drop (call $s.read (local.get 0) (i32.const 0) (i32.const 1))))
    (func $sw (param i32) (drop (call $s.write (local.get 0) (i32.const 0) (i32.const 1))))
    (elem (table $table) (i32.const 0) func $fr $fw $sr $sw)
    (func (export "run") (param $kind i32) (param $action i32)
      (local $ends i64) (local $end i32)
      (local.set $ends (if (result i64) (i32.lt_u (local.get $kind) (i32.const 2))
