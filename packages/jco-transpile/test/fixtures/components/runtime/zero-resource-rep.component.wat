(component
  (component $producer
    (core module $destructor
      (global $last (mut i32) (i32.const -1))
      (global $count (mut i32) (i32.const 0))
      (func (export "destroy") (param i32)
        (global.set $last (local.get 0))
        (global.set $count (i32.add (global.get $count) (i32.const 1))))
      (func (export "last") (result i32) (global.get $last))
      (func (export "count") (result i32) (global.get $count)))
    (core instance $d (instantiate $destructor))
    (type $r (resource (rep i32) (dtor (core func $d "destroy"))))
    (core func $new (canon resource.new $r))
    (core module $m
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (param i32) (result i32) (call $new (local.get 0)))
      ;; Borrows lowered to the resource's defining component are direct reps.
      (func (export "read") (param i32) (result i32) (local.get 0)))
    (core instance $i (instantiate $m (with "" (instance (export "new" (func $new))))))
    (export $exported-r "r" (type $r))
    (func (export "make") (param "rep" u32) (result (own $exported-r))
      (canon lift (core func $i "make")))
    (func (export "read") (param "r" (borrow $exported-r)) (result u32)
      (canon lift (core func $i "read")))
    (func (export "last") (result u32) (canon lift (core func $d "last")))
    (func (export "count") (result u32) (canon lift (core func $d "count"))))

  (component $borrower
    (import "producer" (instance $p
      (export "r" (type $r (sub resource)))
      (export "read" (func (param "r" (borrow $r)) (result u32)))))
    (alias export $p "r" (type $r))
    (alias export $p "read" (func $read))
    (core func $read (canon lower (func $read)))
    (core func $drop (canon resource.drop $r))
    (core module $m
      (import "" "read" (func $read (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (func (export "inspect") (param i32) (result i32)
        (local $rep i32)
        ;; This is a borrowed table entry, including when its stored rep is zero.
        (local.set $rep (call $read (local.get 0)))
        (call $drop (local.get 0))
        (local.get $rep)))
    (core instance $i (instantiate $m (with "" (instance
      (export "read" (func $read))
      (export "drop" (func $drop))))))
    (func (export "inspect") (param "r" (borrow $r)) (result u32)
      (canon lift (core func $i "inspect"))))

  (instance $p (instantiate $producer))
  (instance $b (instantiate $borrower (with "producer" (instance $p))))
  (alias export $p "r" (type $r))
  (alias export $p "make" (func $make))
  (alias export $p "last" (func $last))
  (alias export $p "count" (func $count))
  (alias export $b "inspect" (func $inspect))
  (core func $make (canon lower (func $make)))
  (core func $inspect (canon lower (func $inspect)))
  (core func $drop (canon resource.drop $r))
  (core module $caller
    (import "" "make" (func $make (param i32) (result i32)))
    (import "" "inspect" (func $inspect (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (func (export "run") (param i32) (result i32)
      (local $handle i32)
      (local $rep i32)
      (local.set $handle (call $make (local.get 0)))
      (local.set $rep (call $inspect (local.get $handle)))
      (call $drop (local.get $handle))
      (local.get $rep)))
  (core instance $caller (instantiate $caller (with "" (instance
    (export "make" (func $make))
    (export "inspect" (func $inspect))
    (export "drop" (func $drop))))))
  (func (export "run") (param "rep" u32) (result u32)
    (canon lift (core func $caller "run")))
  (export "last" (func $last))
  (export "count" (func $count)))
