(component
  (component $first-interface
    (core module $destructor
      (func (export "destroy") (param i32)))
    (core instance $destructor (instantiate $destructor))
    (type $token (resource (rep i32) (dtor (core func $destructor "destroy"))))
    (core func $new (canon resource.new $token))
    (core func $rep (canon resource.rep $token))
    (core func $drop (canon resource.drop $token))
    (core module $implementation
      (import "" "new" (func $new (param i32) (result i32)))
      (import "" "rep" (func $rep (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (global $last (mut i32) (i32.const 0))
      (func (export "make") (param i32) (result i32)
        (global.set $last (local.get 0))
        (call $new (local.get 0)))
      (func (export "value") (param i32) (result i32)
        (local.get 0))
      (func (export "roundtrip") (param i32) (result i32)
        (local $value i32)
        (local.set $value (call $rep (local.get 0)))
        (call $drop (local.get 0))
        (call $new (local.get $value)))
      (func (export "get-value") (result i32)
        (global.get $last)))
    (core instance $implementation (instantiate $implementation
      (with "" (instance
        (export "new" (func $new))
        (export "rep" (func $rep))
        (export "drop" (func $drop))))))
    (export $exported-token "token" (type $token))
    (export "token-alias" (type $exported-token))
    (type $value u32)
    (export $exported-value "value" (type $value))
    (export "value-alias" (type $exported-value))
    (type $payload (record (field "value" $exported-value)))
    (export "payload" (type $payload))
    (type $state (enum "ready" "done"))
    (export "state" (type $state))
    (type $permissions (flags "read" "write"))
    (export "permissions" (type $permissions))
    (type $choice (variant (case "none") (case "some" u32)))
    (export "choice" (type $choice))
    (func (export "[constructor]token") (param "value" u32) (result (own $exported-token))
      (canon lift (core func $implementation "make")))
    (func (export "[static]token.make") (param "value" u32) (result (own $exported-token))
      (canon lift (core func $implementation "make")))
    (func (export "[method]token.value") (param "self" (borrow $exported-token)) (result u32)
      (canon lift (core func $implementation "value")))
    (func (export "[static]token.inspect") (param "other" (borrow $exported-token)) (result u32)
      (canon lift (core func $implementation "value")))
    (func (export "get-value") (result $exported-value)
      (canon lift (core func $implementation "get-value")))
    (func (export "roundtrip") (param "other" (own $exported-token)) (result (own $exported-token))
      (canon lift (core func $implementation "roundtrip"))))

  (component $second-interface
    (core module $destructor
      (func (export "destroy") (param i32)))
    (core instance $destructor (instantiate $destructor))
    (type $token (resource (rep i32) (dtor (core func $destructor "destroy"))))
    (core func $new (canon resource.new $token))
    (core func $rep (canon resource.rep $token))
    (core func $drop (canon resource.drop $token))
    (core module $implementation
      (import "" "new" (func $new (param i32) (result i32)))
      (import "" "rep" (func $rep (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (global $last (mut i32) (i32.const 0))
      (func (export "make") (param i32) (result i32)
        (global.set $last (local.get 0))
        (call $new (local.get 0)))
      (func (export "value") (param i32) (result i32)
        (local.get 0))
      (func (export "roundtrip") (param i32) (result i32)
        (local $value i32)
        (local.set $value (call $rep (local.get 0)))
        (call $drop (local.get 0))
        (call $new (local.get $value)))
      (func (export "get-value") (result i32)
        (global.get $last)))
    (core instance $implementation (instantiate $implementation
      (with "" (instance
        (export "new" (func $new))
        (export "rep" (func $rep))
        (export "drop" (func $drop))))))
    (export $exported-token "token" (type $token))
    (export "token-alias" (type $exported-token))
    (type $value u32)
    (export $exported-value "value" (type $value))
    (export "value-alias" (type $exported-value))
    (type $payload (record (field "value" $exported-value)))
    (export "payload" (type $payload))
    (type $state (enum "ready" "done"))
    (export "state" (type $state))
    (type $permissions (flags "read" "write"))
    (export "permissions" (type $permissions))
    (type $choice (variant (case "none") (case "some" u32)))
    (export "choice" (type $choice))
    (func (export "[constructor]token") (param "value" u32) (result (own $exported-token))
      (canon lift (core func $implementation "make")))
    (func (export "[static]token.make") (param "value" u32) (result (own $exported-token))
      (canon lift (core func $implementation "make")))
    (func (export "[method]token.value") (param "self" (borrow $exported-token)) (result u32)
      (canon lift (core func $implementation "value")))
    (func (export "[static]token.inspect") (param "other" (borrow $exported-token)) (result u32)
      (canon lift (core func $implementation "value")))
    (func (export "get-value") (result $exported-value)
      (canon lift (core func $implementation "get-value")))
    (func (export "roundtrip") (param "other" (own $exported-token)) (result (own $exported-token))
      (canon lift (core func $implementation "roundtrip"))))

  (instance $first (instantiate $first-interface))
  (instance $second (instantiate $second-interface))
  (export "example:resources/first" (instance $first))
  (export "example:resources/second" (instance $second))
  (core module $world
    (func (export "get-value") (result i32) (i32.const 99)))
  (core instance $world (instantiate $world))
  (func (export "get-value") (result u32)
    (canon lift (core func $world "get-value"))))
