(component
  ;; Regression coverage for jco#24, reconstructed from wit-bindgen#355 and
  ;; wit-bindgen#377. The old flag64 case is intentionally absent because the
  ;; current component model limits flags types to 32 labels.
  (type $imports (instance
    (type $flag32 (flags
      "b0" "b1" "b2" "b3" "b4" "b5" "b6" "b7"
      "b8" "b9" "b10" "b11" "b12" "b13" "b14" "b15"
      "b16" "b17" "b18" "b19" "b20" "b21" "b22" "b23"
      "b24" "b25" "b26" "b27" "b28" "b29" "b30" "b31"))
    (export "flag32-type" (type (eq $flag32)))
    (type $unaligned-record (record (field "a" u32) (field "b" u64)))
    (export "unaligned-record" (type (eq $unaligned-record)))
    (export "u16" (func (param "x" (list u16))))
    (export "u32" (func (param "x" (list u32))))
    (export "u64" (func (param "x" (list u64))))
    (export "flag32" (func (param "x" (list 1))))
    (export "record" (func (param "x" (list 3))))
    (export "float32" (func (param "x" (list float32))))
    (export "float64" (func (param "x" (list float64))))
    (export "string" (func (param "x" (list string))))
    (export "list" (func (param "x" (list (list u8)))))
  ))
  (import "imports" (instance $imports (type $imports)))

  (core module $memory
    (memory (export "memory") 1)
  )
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory-export))

  (core func $u16 (canon lower (func $imports "u16") (memory $memory-export)))
  (core func $u32 (canon lower (func $imports "u32") (memory $memory-export)))
  (core func $u64 (canon lower (func $imports "u64") (memory $memory-export)))
  (core func $flag32 (canon lower (func $imports "flag32") (memory $memory-export)))
  (core func $record (canon lower (func $imports "record") (memory $memory-export)))
  (core func $float32 (canon lower (func $imports "float32") (memory $memory-export)))
  (core func $float64 (canon lower (func $imports "float64") (memory $memory-export)))
  (core func $string (canon lower (func $imports "string") (memory $memory-export)))
  (core func $list (canon lower (func $imports "list") (memory $memory-export)))

  (core module $test
    (import "memory" "memory" (memory 1))
    (import "imports" "u16" (func $u16 (param i32 i32)))
    (import "imports" "u32" (func $u32 (param i32 i32)))
    (import "imports" "u64" (func $u64 (param i32 i32)))
    (import "imports" "flag32" (func $flag32 (param i32 i32)))
    (import "imports" "record" (func $record (param i32 i32)))
    (import "imports" "float32" (func $float32 (param i32 i32)))
    (import "imports" "float64" (func $float64 (param i32 i32)))
    (import "imports" "string" (func $string (param i32 i32)))
    (import "imports" "list" (func $list (param i32 i32)))

    (func (export "u16") (param $ptr i32)
      (call $u16 (local.get $ptr) (i32.const 1)))
    (func (export "u32") (param $ptr i32)
      (call $u32 (local.get $ptr) (i32.const 1)))
    (func (export "u64") (param $ptr i32)
      (call $u64 (local.get $ptr) (i32.const 1)))
    (func (export "flag32") (param $ptr i32)
      (call $flag32 (local.get $ptr) (i32.const 1)))
    (func (export "record") (param $ptr i32)
      (call $record (local.get $ptr) (i32.const 1)))
    (func (export "float32") (param $ptr i32)
      (call $float32 (local.get $ptr) (i32.const 1)))
    (func (export "float64") (param $ptr i32)
      (call $float64 (local.get $ptr) (i32.const 1)))
    (func (export "string") (param $ptr i32)
      (call $string (local.get $ptr) (i32.const 1)))
    (func (export "list") (param $ptr i32)
      (call $list (local.get $ptr) (i32.const 1)))
  )

  (core instance $test (instantiate $test
    (with "memory" (instance $memory))
    (with "imports" (instance
      (export "u16" (func $u16))
      (export "u32" (func $u32))
      (export "u64" (func $u64))
      (export "flag32" (func $flag32))
      (export "record" (func $record))
      (export "float32" (func $float32))
      (export "float64" (func $float64))
      (export "string" (func $string))
      (export "list" (func $list))
    ))
  ))

  (func (export "test-u16") (param "ptr" u32)
    (canon lift (core func $test "u16") (memory $memory-export)))
  (func (export "test-u32") (param "ptr" u32)
    (canon lift (core func $test "u32") (memory $memory-export)))
  (func (export "test-u64") (param "ptr" u32)
    (canon lift (core func $test "u64") (memory $memory-export)))
  (func (export "test-flag32") (param "ptr" u32)
    (canon lift (core func $test "flag32") (memory $memory-export)))
  (func (export "test-record") (param "ptr" u32)
    (canon lift (core func $test "record") (memory $memory-export)))
  (func (export "test-float32") (param "ptr" u32)
    (canon lift (core func $test "float32") (memory $memory-export)))
  (func (export "test-float64") (param "ptr" u32)
    (canon lift (core func $test "float64") (memory $memory-export)))
  (func (export "test-string") (param "ptr" u32)
    (canon lift (core func $test "string") (memory $memory-export)))
  (func (export "test-list") (param "ptr" u32)
    (canon lift (core func $test "list") (memory $memory-export)))
)
