{
    "name": "@bytecodealliance/jco",
    "version": "1.30.0",
    "description": "JavaScript tooling for working with WebAssembly Components",
    "keywords": [
        "Component",
        "Wasm",
        "WebAssembly"
    ],
    "homepage": "https://github.com/bytecodealliance/jco#readme",
    "bugs": {
        "url": "https://github.com/bytecodealliance/jco/issues"
    },
    "license": "(Apache-2.0 WITH LLVM-exception)",
    "author": "Guy Bedford",
    "contributors": [
        {
            "name": "Guy Bedford"
        },
        {
            "name": "Victor Adossi",
            "email": "vadossi@cosmonic.com"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bytecodealliance/jco.git"
    },
    "bin": {
        "jco": "dist/jco.js"
    },
    "files": [
        "dist",
        "lib"
    ],
    "type": "module",
    "main": "dist/jco.js",
    "types": "dist/jco.d.ts",
    "imports": {
        "#ora": {
            "types": "./dist/ora-shim.d.ts",
            "browser": "./dist/ora-shim.js",
            "default": "ora"
        }
    },
    "exports": {
        ".": {
            "types": "./dist/api.d.ts",
            "browser": "./dist/browser.js",
            "default": "./dist/api.js"
        },
        "./component": {
            "types": "./dist/browser.d.ts",
            "default": "./dist/browser.js"
        }
    },
    "scripts": {
        "build": "cargo xtask build debug && npm run build:ts",
        "build:release": "cargo xtask build release && npm run build:ts",
        "build:ts": "tsc -p tsconfig.json",
        "build:types:preview2-shim": "pnpm run build:types:preview2-shim --include-workspace-root",
        "build:test:components": "cargo xtask build-test-components",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "pnpm run build:ts && vitest run -c test/vitest.ts",
        "test:lts": "pnpm run build:ts && vitest run -c test/vitest.lts.ts",
        "test:extended": "pnpm run build:ts && vitest run -c test/vitest.extended.ts",
        "prepack": "cargo xtask build release"
    },
    "dependencies": {
        "@bytecodealliance/componentize-js": "^0.22.0",
        "@bytecodealliance/componentize-js-0-19-3": "npm:@bytecodealliance/componentize-js@^0.19.3",
        "@bytecodealliance/jco-transpile": "^0.10.0",
        "@bytecodealliance/preview2-shim": "^0.21.0",
        "@bytecodealliance/preview3-shim": "^0.3.2",
        "binaryen": "^130.0.0",
        "commander": "^14",
        "componentize-qjs": "^0.4.2",
        "mkdirp": "^3",
        "ora": "^8",
        "rolldown": "^1.2.4",
        "typescript": "7.0.2",
        "typescript-compiler-api": "npm:typescript@6.0.3"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^19.8.1",
        "@types/node": "^24.3.0",
        "commitlint": "^19.8.1",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "mime": "^4.0.7",
        "oxfmt": "^0.28.0",
        "puppeteer": "catalog:",
        "semver": "^7.7.1",
        "vite": "^7.1.5",
        "vitest": "^4.1.0",
        "which": "^2.0.2"
    }
}
