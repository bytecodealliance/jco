package local:node-cluster-roundtrip;

world test {
  import jco:node/cluster@0.1.0;

  record progress {
    events: string,
    messages: string,
    worker-count: u32,
    exited: bool,
  }

  /// True in the primary, false in a forked worker.
  export is-primary: func() -> bool;
  /// Fork one worker and return its id. Primary only.
  export start: func() -> u32;
  /// Drain host events and report what has been seen so far. Primary only.
  export poll: func() -> progress;
  /// Send a message to the primary. Worker only.
  export report-in: func();
  /// Disconnect every worker. Primary only.
  export shutdown: func();
}
