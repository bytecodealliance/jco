{
    "name": "@bytecodealliance/jco-cm-runtime",
    "version": "0.1.0",
    "description": "Default Component Model runtime for Jco-generated JavaScript",
    "keywords": [
        "Component",
        "Wasm",
        "WebAssembly"
    ],
    "homepage": "https://github.com/bytecodealliance/jco#readme",
    "bugs": {
        "url": "https://github.com/bytecodealliance/jco/issues"
    },
    "license": "(Apache-2.0 WITH LLVM-exception)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bytecodealliance/jco.git"
    },
    "files": [
        "dist",
        "docs"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "default": "./dist/runtime.js"
        },
        "./intrinsics/resource": {
            "types": "./dist/intrinsics/resource.d.ts",
            "default": "./dist/intrinsics/resource.js"
        },
        "./intrinsics/conversion": {
            "types": "./dist/intrinsics/conversion.d.ts",
            "default": "./dist/intrinsics/conversion.js"
        },
        "./intrinsics/js-helper": {
            "types": "./dist/intrinsics/js-helper.d.ts",
            "default": "./dist/intrinsics/js-helper.js"
        },
        "./intrinsics/string": {
            "types": "./dist/intrinsics/string.d.ts",
            "default": "./dist/intrinsics/string.js"
        },
        "./intrinsics/webidl": {
            "types": "./dist/intrinsics/webidl.d.ts",
            "default": "./dist/intrinsics/webidl.js"
        },
        "./intrinsics/core": {
            "types": "./dist/intrinsics/core.d.ts",
            "default": "./dist/intrinsics/core.js"
        },
        "./intrinsics/component": {
            "types": "./dist/intrinsics/component.d.ts",
            "default": "./dist/intrinsics/component.js"
        }
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "types:check": "tsc -p tsconfig.json",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "vitest run -c test/vitest.ts",
        "prepack": "pnpm run build"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
