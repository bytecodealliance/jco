package jco:test-components;

world invalid-handle-kinds {
  // Supplies concrete stream/future types for the raw intrinsic probes. The
  // function itself is never called; only its associated ABI intrinsics are.
  import payloads: func(a: stream<u8>, b: future<u32>, c: stream<u32>, d: future<u64>);
  import fail: func();
  import pending-call: async func() -> u32;
  export run: func(case-index: u32);
  export await-subtask: async func() -> u32;
}
