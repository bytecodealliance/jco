;; Guest-selected wrong-kind handles must fail as Canonical ABI traps.
(component
  (type $s (stream u8)) (type $s-other (stream u32))
  (type $f (future u32)) (type $f-other (future u64))
  (core module $libc (memory (export "mem") 1))
  (core instance $libc (instantiate $libc))
  (core func $set-new (canon waitable-set.new))
  (core func $set-drop (canon waitable-set.drop))
  (core func $join (canon waitable.join))
  (core func $subtask-drop (canon subtask.drop))
  (core func $subtask-cancel (canon subtask.cancel async))
  (core func $stream-new (canon stream.new $s))
  (core func $other-stream-new (canon stream.new $s-other))
  (core func $future-new (canon future.new $f))
  (core func $other-future-new (canon future.new $f-other))
  (core func $stream-read (canon stream.read $s async (memory (core memory $libc "mem"))))
  (core func $future-read (canon future.read $f async (memory (core memory $libc "mem"))))
  (core func $stream-drop (canon stream.drop-readable $s))
  (core func $future-drop (canon future.drop-readable $f))
  (core func $error-drop (canon error-context.drop))
  (core module $m
    (import "" "set-new" (func $set-new (result i32)))
    (import "" "set-drop" (func $set-drop (param i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "subtask-drop" (func $subtask-drop (param i32)))
    (import "" "subtask-cancel" (func $subtask-cancel (param i32) (result i32)))
    (import "" "stream-new" (func $stream-new (result i64)))
    (import "" "other-stream-new" (func $other-stream-new (result i64)))
    (import "" "future-new" (func $future-new (result i64)))
    (import "" "other-future-new" (func $other-future-new (result i64)))
    (import "" "stream-read" (func $stream-read (param i32 i32 i32) (result i32)))
    (import "" "future-read" (func $future-read (param i32 i32) (result i32)))
    (import "" "stream-drop" (func $stream-drop (param i32)))
    (import "" "future-drop" (func $future-drop (param i32)))
    (import "" "error-drop" (func $error-drop (param i32)))
    (func (export "subtask-drop-stream") (call $subtask-drop (i32.wrap_i64 (call $stream-new))))
    (func (export "subtask-drop-set") (call $subtask-drop (call $set-new)))
    (func (export "subtask-cancel-set") (drop (call $subtask-cancel (call $set-new))))
    (func (export "subtask-cancel-zero") (drop (call $subtask-cancel (i32.const 0))))
    (func (export "join-set-source") (call $join (call $set-new) (i32.const 0)))
    (func (export "join-missing-source") (call $join (i32.const 65535) (i32.const 0)))
    (func (export "join-stream-destination") (call $join (i32.wrap_i64 (call $stream-new)) (i32.wrap_i64 (call $stream-new))))
    (func (export "drop-set-stream") (call $set-drop (i32.wrap_i64 (call $stream-new))))
    (func (export "drop-set-zero") (call $set-drop (i32.const 0)))
    (func (export "drop-set-nonempty") (call $join (i32.wrap_i64 (call $stream-new)) (call $set-new)) (call $set-drop (i32.const 3)))
    (func (export "stream-read-future") (drop (call $stream-read (i32.wrap_i64 (call $future-new)) (i32.const 0) (i32.const 1))))
    (func (export "future-read-stream") (drop (call $future-read (i32.wrap_i64 (call $stream-new)) (i32.const 0))))
    (func (export "stream-read-other-type") (drop (call $stream-read (i32.wrap_i64 (call $other-stream-new)) (i32.const 0) (i32.const 1))))
    (func (export "future-read-other-type") (drop (call $future-read (i32.wrap_i64 (call $other-future-new)) (i32.const 0))))
    (func (export "stream-drop-future") (call $stream-drop (i32.wrap_i64 (call $future-new))))
    (func (export "future-drop-stream") (call $future-drop (i32.wrap_i64 (call $stream-new))))
    (func (export "error-drop-stream") (call $error-drop (i32.wrap_i64 (call $stream-new))))
    (func (export "error-drop-zero") (call $error-drop (i32.const 0)))
    (func (export "valid-join")
      (local $stream i32) (local $set i32)
      (local.set $stream (i32.wrap_i64 (call $stream-new))) (local.set $set (call $set-new))
      (call $join (local.get $stream) (local.get $set))
      (call $join (local.get $stream) (i32.const 0))
      (call $set-drop (local.get $set)))
  )
  (core instance $i (instantiate $m (with "" (instance
    (export "set-new" (func $set-new))
    (export "set-drop" (func $set-drop))
    (export "join" (func $join))
    (export "subtask-drop" (func $subtask-drop))
    (export "subtask-cancel" (func $subtask-cancel))
    (export "stream-new" (func $stream-new))
    (export "other-stream-new" (func $other-stream-new))
    (export "future-new" (func $future-new))
    (export "other-future-new" (func $other-future-new))
    (export "stream-read" (func $stream-read))
    (export "future-read" (func $future-read))
    (export "stream-drop" (func $stream-drop))
    (export "future-drop" (func $future-drop))
    (export "error-drop" (func $error-drop))
  ))))
  (func (export "subtask-drop-stream") (canon lift (core func $i "subtask-drop-stream")))
  (func (export "subtask-drop-set") (canon lift (core func $i "subtask-drop-set")))
  (func (export "subtask-cancel-set") (canon lift (core func $i "subtask-cancel-set")))
  (func (export "subtask-cancel-zero") (canon lift (core func $i "subtask-cancel-zero")))
  (func (export "join-set-source") (canon lift (core func $i "join-set-source")))
  (func (export "join-missing-source") (canon lift (core func $i "join-missing-source")))
  (func (export "join-stream-destination") (canon lift (core func $i "join-stream-destination")))
  (func (export "drop-set-stream") (canon lift (core func $i "drop-set-stream")))
  (func (export "drop-set-zero") (canon lift (core func $i "drop-set-zero")))
  (func (export "drop-set-nonempty") (canon lift (core func $i "drop-set-nonempty")))
  (func (export "stream-read-future") (canon lift (core func $i "stream-read-future")))
  (func (export "future-read-stream") (canon lift (core func $i "future-read-stream")))
  (func (export "stream-read-other-type") (canon lift (core func $i "stream-read-other-type")))
  (func (export "future-read-other-type") (canon lift (core func $i "future-read-other-type")))
  (func (export "stream-drop-future") (canon lift (core func $i "stream-drop-future")))
  (func (export "future-drop-stream") (canon lift (core func $i "future-drop-stream")))
  (func (export "error-drop-stream") (canon lift (core func $i "error-drop-stream")))
  (func (export "error-drop-zero") (canon lift (core func $i "error-drop-zero")))
  (func (export "valid-join") (canon lift (core func $i "valid-join")))
)
