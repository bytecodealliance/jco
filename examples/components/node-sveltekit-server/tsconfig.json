{
    "extends": "$app/tsconfig",
    "include": ["src", "test", "*.js"],
    "exclude": ["node_modules", "build", "dist"],
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,
        "strict": true
    }
}
