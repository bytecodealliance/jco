{
    "manifest_version": 3,
    "name": "Jco native messaging example",
    "version": "1.0.0",
    "description": "End-to-end native messaging test for a Jco-built component",
    "key": "",
    "permissions": ["nativeMessaging"],
    "host_permissions": ["http://127.0.0.1/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["http://127.0.0.1/*"],
            "js": ["config.js", "content.js"]
        }
    ]
}
