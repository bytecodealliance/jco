package example:log-pipeline;

interface types {
    record access-log {
        timestamp: string,
        ip: string,
        method: string,
        path: string,
        status: u16,
        country: option<string>,
        risk-score: option<u8>,
    }
}

interface dataset {
    use types.{access-log};

    record dataset-snapshot {
        logs: list<access-log>,
        /// Processor-defined reports encoded as a JSON object.
        reports-json: string,
    }

    /// Replace the shared dataset with raw logs, clearing annotations and reports.
    reset: func(logs: list<access-log>) -> result<_, string>;
    /// Read the current logs and reports without resetting them.
    snapshot: func() -> dataset-snapshot;
}

interface processor {
    use types.{access-log};

    record description {
        name: string,
        description: string,
        default-options: string,
    }

    record batch-result {
        logs: list<access-log>,
        summary: string,
    }

    record single-result {
        /// None means the processor filtered out this log.
        log: option<access-log>,
        summary: string,
    }

    describe: func() -> description;
    /// Process a host-provided batch, updating the shared dataset and reports.
    process-batch: func(logs: list<access-log>, options: string) -> result<batch-result, string>;
    /// Process one host-provided log; filters may remove it.
    process-single: func(log: access-log, options: string) -> result<single-result, string>;
}

world pipeline {
    export types;
    export dataset;
    export processor;
}
