package example:browser-p2-shims;

/// Operations invoked by the interactive browser demo.
interface cli-demo {
    /// Write a line through the guest's WASI CLI stdout stream.
    write-to-stdout: func(message: string);

    /// Write a line through the guest's WASI CLI stderr stream.
    write-to-stderr: func(message: string);
}

interface clocks-demo {
    record clock-snapshot {
        wall-seconds: u64,
        wall-nanoseconds: u32,
        monotonic-nanoseconds: u64,
    }

    /// Read both browser-backed WASI clocks.
    read-clocks: func() -> clock-snapshot;
}

interface filesystem-demo {
    /// Store and read `hello world` through the configured filesystem adapter.
    write-hello-world: func() -> string;
}

interface outgoing-http-demo {
    record response {
        status: u16,
        intercepted-by: string,
        body: string,
    }

    /// Make an outgoing request through the host's WASI HTTP implementation.
    request: func(message: string) -> response;
}

/// Guest-owned socket resources backed by the host's injected WASI sockets.
/// This constructor-shaped bridge works around ComponentizeJS trapping when a
/// `wasi:sockets` resource is returned from an imported function.
interface socket-server {
    resource tcp-server {
        constructor();
        start-bind: func(port: u16);
        finish-bind: func();
        start-listen: func();
        finish-listen: func();
        accept: func();
        read: func() -> string;
        write: func(message: string);
    }

    resource udp-server {
        constructor();
        start-bind: func(port: u16);
        finish-bind: func();
        %stream: func();
        receive: func() -> string;
        send: func(message: string);
    }
}

interface tcp-demo {
    /// Accept one queued client connection and echo its message.
    serve-once: func();
}

interface udp-demo {
    /// Receive one queued client datagram and echo its message.
    serve-once: func();
}

world component {
    import wasi:clocks/monotonic-clock@0.2.12;
    import wasi:clocks/wall-clock@0.2.12;
    import wasi:filesystem/preopens@0.2.12;
    import wasi:filesystem/types@0.2.12;
    import socket-server;

    export cli-demo;
    export clocks-demo;
    export filesystem-demo;
    export outgoing-http-demo;
    export tcp-demo;
    export udp-demo;
    export wasi:http/incoming-handler@0.2.12;
}
